{
  "author": {
    "name": "Alan Garny",
    "email": "a.garny@auckland.ac.nz"
  },
  "bugs": {
    "url": "https://github.com/opencor/plot/issues"
  },
  "description": "A Vue 3 component for plotting data, using uPlot, Canvas 2D, and WebGL.",
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "homepage": "https://github.com/opencor/plot",
  "keywords": [
    "vue",
    "component",
    "opencor",
    "plot",
    "chart",
    "uplot",
    "canvas",
    "webgl"
  ],
  "license": "Apache-2.0",
  "module": "dist/opencor-plot.es.js",
  "name": "@opencor/plot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencor/plot.git"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "0.20261119.0",
  "engines": {
    "bun": ">=1.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/opencor-plot.es.js"
    },
    "./style.css": "./dist/opencor-plot.css"
  },
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && bun --bun scripts/type.check.ts --project tsconfig.lib.types.json && bun scripts/declarations.clean.ts",
    "build:demo": "vite build",
    "clean": "bun scripts/clean.ts",
    "dependencies:update": "bun scripts/dependencies.update.ts",
    "dev": "vite",
    "format": "bunx --bun biome format --fix --max-diagnostics=none",
    "format:check": "bunx --bun biome format --max-diagnostics=none",
    "lint": "bunx --bun biome lint --fix --error-on-warnings --max-diagnostics=none && bunx stylelint '**/*.css' --allow-empty-input --fix",
    "lint:check": "bunx --bun biome lint --error-on-warnings --max-diagnostics=none && bunx stylelint '**/*.css' --allow-empty-input",
    "typecheck": "bun --bun scripts/type.check.ts --noEmit",
    "version:new": "bun scripts/version.new.ts"
  },
  "dependencies": {
    "uplot": "1.6.32"
  },
  "peerDependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "^1.4.4",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.8",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
